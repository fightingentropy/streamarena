[Unit]
Description=StreamArena backend
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=streamarena
Group=streamarena
WorkingDirectory=/opt/streamarena/current
EnvironmentFile=/etc/streamarena/env
Environment=HOME=/var/lib/streamarena
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/streamarena/.cache/ms-playwright
Environment=STREAMARENA_NODE_DEPS_DIR=/opt/streamarena/runtime
Environment=HOST=127.0.0.1
Environment=PORT=5173
ExecStart=/opt/streamarena/current/bin/streamarena-backend
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
# Let Axum's 30-second graceful shutdown finish before killing child helpers.
KillMode=mixed
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/streamarena
StandardOutput=journal
StandardError=journal
SyslogIdentifier=streamarena

[Install]
WantedBy=multi-user.target
