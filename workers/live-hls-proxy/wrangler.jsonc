{
  // Compatibility config for remaining Wrangler commands (for example tail).
  // Development, builds and deployments use cloudflare.config.ts through cf.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streamarena-live-hls-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  // The custom domain is the primary playback endpoint. Keep workers.dev
  // available as an alternate hostname; both run this same Worker version.
  // Fetch caching depends on the upstream response policy and Cloudflare zone
  // behavior, so verify actual cache headers instead of inferring from hostname.
  // LIVE_HLS_RESOURCE_WORKER_BASE on the mini selects the public hostname.
  "routes": [{ "pattern": "live.streamarena.xyz", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  // Public origin the playlist/viaOrigin routes relay to (the mini behind
  // Caddy). The path+query is forwarded verbatim so signatures keep validating.
  "vars": { "ORIGIN_BASE": "https://streamarena.xyz" }
  // Secrets (set out-of-band, never committed):
  //   wrangler secret put LIVE_HLS_PROXY_SECRET
  //     Must equal the mini's LIVE_HLS_PROXY_SECRET so signatures validate.
  //   wrangler secret put LIVE_HLS_LEGACY_SIGNATURE_ACCEPT_UNTIL
  //     Temporary v1->v2 rollout deadline (absolute Unix seconds, <=6h ahead).
  //     Omit in normal operation; missing-expiry URLs then fail closed.
  //   wrangler secret put ORIGIN_DIRECT_BASE
  //     Optional http:// base on a grey-cloud (DNS-only) hostname for the
  //     origin IP; origin fetches then connect direct instead of re-entering
  //     the zone edge (dodging the L7 DDoS managed ruleset, which is the whole
  //     point — cf.resolveOverride is silently ignored on workers.dev). Kept
  //     secret, and served over plain HTTP, so neither the public repo nor CT
  //     logs advertise a name that resolves to the origin IP.
}
