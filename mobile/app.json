{
  "expo": {
    "name": "Netflix",
    "slug": "streamarena-mobile",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "streamarena",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xyz.streamarena.app",
      "buildNumber": "8",
      "infoPlist": {
        "CFBundleDisplayName": "Netflix",
        "CFBundleName": "Netflix",
        "NSFaceIDUsageDescription": "Allow Netflix to use Face ID for secure sign in.",
        "UIViewControllerBasedStatusBarAppearance": true,
        "UIBackgroundModes": [
          "audio",
          "fetch"
        ],
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        },
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "xyz.streamarena.app",
      "versionCode": 4,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withSceneLifecycle",
      "./plugins/withSigning",
      "./plugins/withXcode27DeploymentTarget",
      "expo-router",
      "expo-secure-store",
      [
        "react-native-video",
        {
          "enableBackgroundAudio": true,
          "enableNotificationControls": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sqlite",
      "expo-status-bar"
    ],
    "extra": {
      "apiOrigin": "https://streamarena.xyz",
      "router": {},
      "eas": {
        "projectId": "80548de6-ab1e-4323-8440-eea1ab7acd0c"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "owner": "magemerlin"
  }
}
